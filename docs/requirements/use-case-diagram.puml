
@startuml
left to right direction
skinparam packageStyle rectangle
skinparam shadowing false

actor "System Administrator" as Admin
actor "Security Analyst" as Analyst
actor "Honeypot / Event Source" as Source

rectangle "HIVE Honeypot Network" {
    usecase "Sign In" as UC1
    usecase "Manage Users and Roles" as UC2
    usecase "Register and Manage Honeypots" as UC3
    usecase "Submit Security Events" as UC4
    usecase "Normalize and Store Events" as UC5
    usecase "Search and View Events" as UC6
    usecase "View Dashboard and Alerts" as UC7
    usecase "Review Audit Logs" as UC8
}

Admin --> UC1
Admin --> UC2
Admin --> UC3
Admin --> UC8

Analyst --> UC1
Analyst --> UC6
Analyst --> UC7

Source --> UC4

UC4 ..> UC5 : <<include>>

@enduml
